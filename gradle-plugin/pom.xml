<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.codiqo</groupId>
        <artifactId>codiqo-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>codiqo-gradle-plugin</artifactId>
    <packaging>jar</packaging>
    <name>Codiqo Gradle Plugin</name>
    <description>Gradle plugin that runs Codiqo code-quality analysis against a Gradle build and dumps the analysis submission. Mirrors the Maven plugin; shares the analysis engine and submission pipeline.</description>

    <dependencies>
        <!-- compiled against the Gradle API, provided by the Gradle runtime; version managed by parent -->
        <dependency>
            <groupId>dev.gradleplugins</groupId>
            <artifactId>gradle-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- shared codiqo modules (build-tool neutral) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codiqo-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codiqo-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codiqo-submit</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codiqo-openapi</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- engine libs referenced directly by the plugin glue -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.classgraph</groupId>
            <artifactId>classgraph</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
        </dependency>
        <!-- the collected model is piped to the analysis worker as JSON -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!--
            JaCoCo.VERSION pins the agent the analysis build instruments with to the one it parses the exec file with.
            the version is explicit rather than inherited from the parent's dependencyManagement because Gradle resolves
            this POM itself when the init script puts the plugin on its classpath, and it did not apply the managed
            version — leaving Gradle on 0.8.14 while Maven used 0.8.15. an interpolated literal leaves it no choice.
        -->
        <dependency>
            <groupId>org.jacoco</groupId>
            <artifactId>org.jacoco.core</artifactId>
            <version>${jacoco.version}</version>
        </dependency>

        <!-- engine libs needed at runtime (loaded reflectively by the analysis pipeline) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codiqo-lang-java</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codiqo-llm</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            the analysis worker is a bare JVM, so it needs an SLF4J binding for SlfLogFactory to reach a console at all;
            the daemon never uses it, because there slf4j-api is loaded by Gradle's own classloader and its provider
            lookup cannot see this child classloader. slf4j-simple rather than logback because the worker configures
            levels and layout with -D flags at the fork site, so no logback.xml has to be shipped inside the plugin jar.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <artifactId>lombok</artifactId>
            <groupId>org.projectlombok</groupId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
