<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.codiqo</groupId>
        <artifactId>codiqo-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>codiqo-openapi</artifactId>
    <name>Codiqo OpenAPI</name>
    <description>Generated OpenAPI client and model classes for the Codiqo backend API.</description>
    <dependencies>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- -->
        <!-- provided -->
        <!-- -->
        <dependency>
            <artifactId>lombok</artifactId>
            <groupId>org.projectlombok</groupId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-artifact</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- the server interface only: the backend has Spring on its classpath, the client's users never load it -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- -->
        <!-- test dependencies -->
        <!-- -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <!--
                        The three executions share one output folder, and this first one empties it: a file a later
                        execution no longer generates (the JAX-RS ApiApi, once the Spring one replaced it) would
                        otherwise stay in a compile source root of a build without clean, and fail it as a duplicate
                        class. Executions bound to one phase run in declaration order, so this one must stay first.
                    -->
                    <execution>
                        <id>generate-codiqo-client</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <cleanupOutput>true</cleanupOutput>
                            <inputSpec>${project.basedir}/src/main/resources/codiqo.yaml</inputSpec>
                            <generatorName>java</generatorName>
                            <library>native</library>

                            <apiPackage>io.codiqo.client.api</apiPackage>
                            <modelPackage>io.codiqo.client.model</modelPackage>
                            <invokerPackage>io.codiqo.client</invokerPackage>

                            <configOptions>
                                <dateLibrary>java8</dateLibrary>
                                <useJakartaEe>true</useJakartaEe>
                                <bigDecimalAsString>true</bigDecimalAsString>
                                <caseInsensitiveResponseHeaders>true</caseInsensitiveResponseHeaders>
                                <failOnUnknownProperties>false</failOnUnknownProperties>
                                <serializationLibrary>jackson</serializationLibrary>
                                <useJackson3>true</useJackson3>
                                <useGzipFeature>false</useGzipFeature>
                                <openApiNullable>false</openApiNullable>
                                <legacyDiscriminatorBehavior>false</legacyDiscriminatorBehavior>
                                <discriminatorCaseSensitive>true</discriminatorCaseSensitive>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <generateApiDocumentation>true</generateApiDocumentation>
                                <generateModelDocumentation>true</generateModelDocumentation>
                                <generateBuilders>true</generateBuilders>
                                <supportUrlQuery>false</supportUrlQuery>
                                <useBeanValidation>false</useBeanValidation>
                                <performBeanValidation>false</performBeanValidation>
                            </configOptions>

                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <importMappings>
                                <importMapping>Date=java.util.Date</importMapping>
                                <importMapping>Objects=java.util.Objects</importMapping>
                                <importMapping>Locale=java.util.Locale</importMapping>
                            </importMappings>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-codiqo-server</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/codiqo.yaml</inputSpec>
                            <generatorName>jaxrs-spec</generatorName>
                            <generateApis>false</generateApis>
                            <generateSupportingFiles>false</generateSupportingFiles>

                            <modelPackage>io.codiqo.server.model</modelPackage>

                            <configOptions>                                
                                <dateLibrary>java8</dateLibrary>
                                <useJakartaEe>true</useJakartaEe>
                                <bigDecimalAsString>true</bigDecimalAsString>
                                <caseInsensitiveResponseHeaders>true</caseInsensitiveResponseHeaders>
                                <failOnUnknownProperties>false</failOnUnknownProperties>
                                <serializationLibrary>jackson</serializationLibrary>
                                <useGzipFeature>true</useGzipFeature>
                                <openApiNullable>false</openApiNullable>
                                <legacyDiscriminatorBehavior>false</legacyDiscriminatorBehavior>
                                <discriminatorCaseSensitive>true</discriminatorCaseSensitive>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <generateModelDocumentation>true</generateModelDocumentation>
                                <generateBuilders>true</generateBuilders>
                                <supportUrlQuery>false</supportUrlQuery>
                                <useBeanValidation>true</useBeanValidation>
                                <performBeanValidation>true</performBeanValidation>
                                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                                <sourceFolder>jaxrs</sourceFolder>
                            </configOptions>

                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <importMappings>
                                <importMapping>Date=java.util.Date</importMapping>
                                <importMapping>Objects=java.util.Objects</importMapping>
                                <importMapping>Locale=java.util.Locale</importMapping>
                            </importMappings>
                        </configuration>
                    </execution>
                    <!--
                        The backend's Spring WebFlux interface. The body is a plain type (reactive=false), never a Mono,
                        and every operation answers a CompletableFuture, which WebFlux subscribes to like a Mono. The
                        caller's credential headers come from x-spring-provide-args in the spec.
                    -->
                    <execution>
                        <id>generate-codiqo-server-api</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/codiqo.yaml</inputSpec>
                            <generatorName>spring</generatorName>
                            <library>spring-boot</library>
                            <generateModels>false</generateModels>
                            <generateSupportingFiles>false</generateSupportingFiles>

                            <apiPackage>io.codiqo.server.api</apiPackage>
                            <modelPackage>io.codiqo.server.model</modelPackage>

                            <configOptions>
                                <dateLibrary>java8</dateLibrary>
                                <useJakartaEe>true</useJakartaEe>
                                <useSpringBoot4>true</useSpringBoot4>
                                <openApiNullable>false</openApiNullable>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <interfaceOnly>true</interfaceOnly>
                                <skipDefaultInterface>true</skipDefaultInterface>
                                <reactive>false</reactive>
                                <responseWrapper>CompletableFuture</responseWrapper>
                                <useResponseEntity>true</useResponseEntity>
                                <useBeanValidation>true</useBeanValidation>
                                <performBeanValidation>true</performBeanValidation>
                                <!--
                                    no class-level @Validated: Spring skips its built-in validation of a controller's
                                    constrained parameters (a @Pattern path variable, a @Min query parameter) when the
                                    type carries @Validated, and the backend runs no AOP method validation instead
                                -->
                                <useSpringBuiltInValidation>true</useSpringBuiltInValidation>
                                <!-- Spring 7 deprecates its own @Nullable for JSpecify's -->
                                <useJspecify>true</useJspecify>
                                <annotationLibrary>none</annotationLibrary>
                                <documentationProvider>none</documentationProvider>
                                <sourceFolder>spring</sourceFolder>
                            </configOptions>

                            <generateApiTests>false</generateApiTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>parse-version</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>parse-version</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>add-resource</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-resource</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/generated-sources/openapi/src/main/java</directory>
                                </resource>
                                <resource>
                                    <directory>${project.build.directory}/generated-sources/openapi/jaxrs</directory>
                                </resource>
                                <resource>
                                    <directory>${project.build.directory}/generated-sources/openapi/spring</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>